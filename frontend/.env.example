# Hybrid inbox (recommended for Netlify). Only the PUBLIC anon/publishable key belongs here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_ENROLL_EXAM=CS101

# Direct mode only: leave empty when FastAPI serves the built app or via the Vite proxy.
VITE_API_BASE=

# Development server only; never exposed to the browser.
BACKEND_ORIGIN=http://127.0.0.1:8000
